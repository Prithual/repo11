{
  "name": "haul-multiplayer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:client": "esbuild client/client.ts --bundle --outfile=public/client.js",
    "build": "esbuild client/client.ts --bundle --minify --outfile=public/client.js",
    "start": "tsx src/server.ts",
    "dev": "npm run build:client && tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "tsx": "^4.19.0",
    "esbuild": "^0.24.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "@types/three": "^0.169.0",
    "typescript": "^5.6.0"
  }
}
